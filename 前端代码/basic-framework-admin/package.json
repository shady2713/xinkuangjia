{
  "name": "admin-console-workspace",
  "version": "5.5.9",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "vue",
    "vue admin",
    "admin console",
    "management system",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "project-team",
    "email": "dev@example.com"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docker": "pnpm run build:ele && docker build -t basic-framework-admin:local apps/web-ele",
    "build:ele": "pnpm run build --filter=@vben/web-ele",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:ele": "pnpm -F @vben/web-ele run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r --if-present run stub",
    "preinstall": "npx only-allow pnpm",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "quality:ci": "pnpm install --frozen-lockfile && pnpm run quality:verify",
    "quality:workspace": "python -B -X utf8 ./scripts/quality/verify_workspace_constraints.py",
    "test:unit:isolated": "python -B -X utf8 ./scripts/quality/run_frontend_tests.py --suite unit",
    "test:e2e:isolated": "python -B -X utf8 ./scripts/quality/run_frontend_tests.py --suite e2e",
    "test:coverage": "python -B -X utf8 ./scripts/quality/run_frontend_tests.py --suite unit --coverage",
    "coverage:uncovered": "python -B -X utf8 ./scripts/quality/report_coverage.py",
    "release:pack": "python -B -X utf8 ./scripts/quality/release_artifacts.py pack",
    "release:verify": "python -B -X utf8 ./scripts/quality/release_artifacts.py verify",
    "release:smoke": "python -B -X utf8 ./scripts/quality/release_artifacts.py smoke",
    "quality:delivery:test": "python -B -X utf8 -m unittest discover -s ./scripts/quality/tests -p test_delivery_tools.py",
    "quality:analysis:test": "node --test internal/vite-config/tests/bundle-analysis.node.mjs",
    "quality:dependencies": "python -B -X utf8 ./scripts/quality/workspace_audit.py --kind dependencies",
    "quality:layers": "python -B -X utf8 ./scripts/quality/workspace_audit.py --kind layers",
    "quality:config": "python -B -X utf8 ./scripts/quality/workspace_audit.py --kind config",
    "quality:development": "python -B -X utf8 ./scripts/quality/workspace_audit.py --kind all",
    "quality:development:test": "python -B -X utf8 -m unittest discover -s ./scripts/quality/tests -p test_development_tools.py",
    "graph:modules": "python -B -X utf8 ./scripts/quality/generate_module_graph.py",
    "graph:modules:check": "python -B -X utf8 ./scripts/quality/generate_module_graph.py --check",
    "clean:artifacts": "python -B -X utf8 ./scripts/quality/clean_artifacts.py",
    "build:recorded": "python -B -X utf8 ./scripts/quality/build_record.py prepare && pnpm run build:ele && python -B -X utf8 ./scripts/quality/build_record.py finish",
    "build:record:verify": "python -B -X utf8 ./scripts/quality/build_record.py verify",
    "quality:workspace:test": "python -B -X utf8 -m unittest discover -s ./scripts/quality/tests -p test_workspace_constraints.py",
    "quality:prod-scan": "node ./scripts/quality/scan-production.mjs",
    "quality:source-scan": "node ./scripts/quality/scan-production.mjs --source-only",
    "quality:verify": "pnpm run quality:workspace && pnpm run quality:source-scan && pnpm run quality:mermaid && pnpm run check:type && pnpm run lint && pnpm run test:unit && pnpm run build:ele && pnpm run quality:prod-scan && pnpm run test:e2e",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "catalog": "pnpx codemod pnpm/catalog",
    "quality:comments": "node ./scripts/check-quality.mjs web",
    "quality:comments:all": "node ./scripts/check-quality.mjs web --all",
    "quality:mermaid": "node ./scripts/check-quality.mjs mermaid",
    "quality:test": "node --test ./internal/lint-configs/eslint-config/tests/quality.node.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/prettier-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "jsdom": "catalog:",
    "lefthook": "catalog:",
    "markdown-it": "catalog:",
    "mermaid": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
