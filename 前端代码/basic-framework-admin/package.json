{
  "name": "basic-framework-admin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "api:gen": "node ./scripts/generate-api-types.mjs",
    "api:check": "node ./scripts/generate-api-types.mjs --check",
    "quality:gates": "pnpm run api:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.8.4",
    "cropperjs": "^1.6.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.8",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "sm-crypto": "^0.3.13",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.14.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.4.4",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.6",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
