# 复制本文件为 .env 后再填写真实环境配置。
# .env 已被 .gitignore 忽略；本模板文件可提交到 Git。

# 服务基础配置
SERVER_PORT=48080
APP_VERSION=1.0.0
SPRING_PROFILES_ACTIVE=prod

# 数据库配置（Spring Boot 默认 HikariCP）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=basic_framework
DB_USERNAME=your_db_username
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 批量导入用户初始密码（留空时拒绝批量导入）
USER_INIT_PASSWORD=

# SM2 密码传输配置（64 位十六进制私钥，缺失时拒绝启动）
SM2_PRIVATE_KEY=
SM2_TIMESTAMP_WINDOW=5m
SM2_NONCE_TTL=10m
SM2_REPLAY_CHECK_ENABLED=true

# 登录失败锁定
LOGIN_LOCK_ENABLED=true
LOGIN_LOCK_MAX_FAILURES=5
LOGIN_LOCK_DURATION=30m
LOGIN_LOCK_FAILURE_WINDOW=30m

# 短信登录失败锁定
SMS_LOGIN_LOCK_ENABLED=true
SMS_LOGIN_LOCK_MAX_FAILURES=5
SMS_LOGIN_LOCK_IP_MAX_FAILURES=20
SMS_LOGIN_LOCK_DURATION=30m
SMS_LOGIN_LOCK_FAILURE_WINDOW=30m

# 管理后台会话
SESSION_IDLE_TIMEOUT=30m
ACCESS_TOKEN_VALIDITY=30m
REFRESH_TOKEN_VALIDITY=30d
REDIS_UNAVAILABLE_STRATEGY=local-fallback

# 验证码配置
CAPTCHA_AES_STATUS=false

# 管理后台入口地址与 CORS
ADMIN_UI_URL=http://localhost:5175
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# API 文档开关（生产建议保持 false）
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
KNIFE4J_ENABLED=false
SWAGGER_TITLE=basic-framework API
SWAGGER_DESCRIPTION=Admin and app API documentation
SWAGGER_AUTHOR=李杰
SWAGGER_EMAIL=opensource@example.com
SWAGGER_LICENSE=MIT
SWAGGER_LICENSE_URL=https://example.com/basic-framework/LICENSE

# 统一文件存储（local: 本地磁盘/断网政务内网兜底；aliyun-oss: 生产阿里云 OSS）
FILE_STORAGE_PROVIDER=local
FILE_LOCAL_BASE_PATH=./.local-storage
FILE_LOCAL_DOMAIN=/admin-api/infra/file/content
FILE_LOCAL_PUBLIC_ACCESS=true
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_PUBLIC_URL=
ALIYUN_OSS_PUBLIC_ACCESS=false
ALIYUN_OSS_SIGNING_ENDPOINT=

# 阿里云短信配置（enabled=false 时本地开发安全空发送）
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
ALIYUN_SMS_RESET_PASSWORD_TEMPLATE_CODE=
