# 复制本文件为 .env 后再填写真实环境配置。
# .env 已被 .gitignore 忽略；本模板文件可提交到 Git。

# 服务基础配置
SERVER_PORT=48080
APP_VERSION=1.0.0
# Spring 运行环境；local/dev 使用普通控制台日志，prod 使用 JSON 日志。
SPRING_PROFILES_ACTIVE=local

# 主库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=basic_framework
DB_USERNAME=your_db_username
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# 从库配置；没有独立从库时，可与主库保持一致。
DB_SLAVE_HOST=127.0.0.1
DB_SLAVE_PORT=3306
DB_SLAVE_NAME=basic_framework
DB_SLAVE_USERNAME=your_slave_db_username
DB_SLAVE_PASSWORD=CHANGE_ME_DB_SLAVE_PASSWORD

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 数据迁移与字段加密配置
FLYWAY_ENABLED=true
MYBATIS_ENCRYPT_PASSWORD=

# Quartz 定时任务配置
# QUARTZ_AUTO_STARTUP=false 可临时关闭定时任务调度器。
# QUARTZ_JDBC_INITIALIZE_SCHEMA 可选 never/always/embedded；本地首次建 QRTZ_ 表可临时改为 always，建完后建议改回 never。
QUARTZ_AUTO_STARTUP=true
QUARTZ_JDBC_INITIALIZE_SCHEMA=never

# 验证码配置
# 当前前端验证码组件使用 AES-CBC；Anji Captcha 后端使用 AES-ECB，保持 false 可避免坐标解密失败。
CAPTCHA_AES_STATUS=false

# 日志级别配置
LOG_LEVEL_BASICFRAMEWORK_MODULE=INFO
LOG_LEVEL_SPRING_POST_PROCESSOR_REGISTRATION_DELEGATE=ERROR

# 管理后台与跨域配置
ADMIN_UI_URL=http://localhost:5175
CORS_ALLOWED_ORIGIN=http://localhost:5175

# API 文档开关；生产环境建议保持 false。
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
KNIFE4J_ENABLED=false
SWAGGER_TITLE=basic-framework API
SWAGGER_DESCRIPTION=Admin and app API documentation
SWAGGER_AUTHOR=李杰
SWAGGER_EMAIL=opensource@example.com
SWAGGER_LICENSE=MIT
SWAGGER_LICENSE_URL=https://example.com/basic-framework/LICENSE

# API 加解密配置；开启后需要填写请求和响应密钥。
API_ENCRYPT_ENABLE=false
API_ENCRYPT_ALGORITHM=AES
API_ENCRYPT_REQUEST_KEY=
API_ENCRYPT_RESPONSE_KEY=

# 统一 MinIO 文件存储。凭据只填写在被 Git 忽略的 .env 中。
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=basic-framework
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
