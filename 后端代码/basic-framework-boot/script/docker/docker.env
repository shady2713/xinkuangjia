# 此文件是可提交的模板，复制到同目录被 Git 忽略的 .env 后填写真实凭据。
# 先构建 basic-framework-server/target/basic-framework-server.jar，再运行：
# docker compose --env-file .env -f docker-compose.yml config --quiet
# docker compose --env-file .env -f docker-compose.yml up -d --build
# 数据卷沿用时不会自动重新创建用户或改密码；升级凭据须由部署人员独立执行。
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
DB_NAME=basic_framework
DB_USERNAME=basic_framework_app
DB_PASSWORD=
REDIS_PORT=6379
REDIS_PASSWORD=
SERVER_PORT=48080
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

ADMIN_UI_URL=https://admin.example.com
# 同源部署保持空；跨域仅填写逗号分隔的精确 http(s) 源，不允许通配符或路径。
CORS_ALLOWED_ORIGIN=
# 精确受控代理源 IP 正则；用 [.] 表示点，避免 .properties 与 env_file 的转义差异。
TRUSTED_PROXY_REGEX=(?!)
AUTH_REGISTRATION_ENABLED=false

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=basic-framework
MINIO_SECURE=true
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=

FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_DAILY_BYTES=209715200
FILE_UPLOAD_DAILY_REQUESTS=100
SMS_SEND_FREQUENCY=1m
SMS_SEND_MAXIMUM_PER_DAY=10
SMS_SEND_IP_WINDOW=1m
SMS_SEND_MAXIMUM_PER_IP=50
SMS_VERIFY_MAXIMUM_FAILURES=5
SMS_VERIFY_WINDOW=1m
SMS_VERIFY_MAXIMUM_PER_MOBILE=10
SMS_VERIFY_MAXIMUM_PER_IP=50
