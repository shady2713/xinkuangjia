<configuration>
    <!-- 格式化输出：%d 表示日期，%X{tid} 输出链路追踪标识，%thread 表示线程名，%-5level 为日志级别，%msg 为日志消息 -->
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid:-}] [%thread] %highlight(%-5level) %cyan(%logger{50}:%L) - %msg%n"/>
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid:-}] [%thread] %-5level %logger{50}:%L - %msg%n"/>
    <!-- JSON 格式模板，对反斜杠、双引号、回车、换行与制表符逐层转义，保证生产日志严格符合 RFC 8259 -->
    <property name="JSON_LOG_PATTERN" value='{"timestamp":"%d{yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ}","traceId":"%X{tid:-}","level":"%level","thread":"%replace(%thread){&apos;[\\\\]&apos;,&apos;\\\\\\\\&apos;}","logger":"%logger{50}","line":"%L","message":"%replace(%replace(%replace(%replace(%replace(%msg){&apos;[\\\\]&apos;,&apos;\\\\\\\\&apos;}){&apos;&quot;&apos;,&apos;\\&quot;&apos;}){&apos;\r&apos;,&apos;\\r&apos;}){&apos;\n&apos;,&apos;\\n&apos;}){&apos;\t&apos;,&apos;\\t&apos;}","exception":"%replace(%replace(%replace(%replace(%replace(%xException{10}){&apos;[\\\\]&apos;,&apos;\\\\\\\\&apos;}){&apos;&quot;&apos;,&apos;\\&quot;&apos;}){&apos;\r&apos;,&apos;\\r&apos;}){&apos;\n&apos;,&apos;\\n&apos;}){&apos;\t&apos;,&apos;\\t&apos;}"}%n'/>

    <!-- ==================== local/dev 环境 ==================== -->
    <springProfile name="local,dev">

        <!-- 控制台 Appender（带颜色高亮） -->
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <!-- 文件 Appender -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <maxFileSize>10MB</maxFileSize>
            </rollingPolicy>
        </appender>
        <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
            <discardingThreshold>0</discardingThreshold>
            <queueSize>512</queueSize>
            <appender-ref ref="FILE"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ASYNC"/>
        </root>

    </springProfile>

    <!-- ==================== prod 环境 ==================== -->
    <springProfile name="prod">

        <!-- 控制台 JSON Appender（适配容器日志采集） -->
        <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${JSON_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <!-- 文件 JSON Appender -->
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${JSON_LOG_PATTERN}</pattern>
            </encoder>
            <file>${LOG_FILE}</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxHistory>60</maxHistory>
                <maxFileSize>50MB</maxFileSize>
            </rollingPolicy>
        </appender>
        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <discardingThreshold>0</discardingThreshold>
            <queueSize>1024</queueSize>
            <appender-ref ref="FILE_JSON"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT_JSON"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>

    </springProfile>

    <!-- ==================== test 环境 ==================== -->
    <springProfile name="test">

        <!-- 控制台 Appender -->
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>

    </springProfile>

    <!-- 未配置或误配置 Profile 时，保底输出到控制台，避免启动后完全无日志 -->
    <springProfile name="!local &amp; !dev &amp; !prod &amp; !test">
        <appender name="STDOUT_FALLBACK" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT_FALLBACK"/>
        </root>
    </springProfile>

    <!-- SkyWalking Appender：GRPC 日志收集（按需启用） -->
    <!--
    <appender name="SKYWALKING" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>[%tid] ${FILE_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>
    -->

</configuration>
